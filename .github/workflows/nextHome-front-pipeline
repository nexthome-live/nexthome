# Deploys the Vite/React frontend to GitHub Pages.
#
# How it works:
#   1. Checkout the repo.
#   2. Set up Node 20.
#   3. Install npm dependencies.
#   4. Build the Vite app, injecting VITE_API_BASE_URL from a repo secret so
#      the deployed site talks to the live backend instead of localhost.
#   5. Upload the static build artifact to GitHub Pages.
#   6. Deploy to Pages (visible at https://<org>.github.io/nextHome).
#
# Required GitHub Pages setup (one-time, in repo Settings → Pages):
#   - Source: "GitHub Actions"
#
# Required GitHub repository secret:
#   - VITE_API_BASE_URL
#       Example: https://nexthome-app-xxxxx-uc.a.run.app
#       (No trailing slash. Must be the public URL of the deployed backend.)

name: Deploy frontend to GitHub Pages

on:
  # Deploy on pushes to main.
  push:
    branches: ["main"]
    paths:
      - "frontend/**"
      - ".github/workflows/deploy-frontend-pages.yml"
  # Allow manual runs from the Actions tab.
  workflow_dispatch:

# Same minimal permissions the Jekyll sample uses.
permissions:
  contents: read
  pages: write
  id-token: write

# Don't cancel an in-flight Pages deploy — let it finish.
concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: frontend/package-lock.json

      - name: Install dependencies
        run: npm ci

      # Build the Vite app. We pass VITE_API_BASE_URL so the deployed site
      # talks to the live backend. Falls back to the local default if the
      # secret isn't set yet.
      - name: Build with Vite
        env:
          VITE_API_BASE_URL: ${{ secrets.VITE_API_BASE_URL }}
        run: npm run build

      - name: Setup Pages
        uses: actions/configure-pages@v5

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          # Vite's default output directory is `dist` inside the frontend
          # project. `actions/upload-pages-artifact` resolves this relative
          # to `working-directory`, which is set to `frontend` above.
          path: ./dist

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
